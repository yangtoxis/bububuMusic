DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Путь к базе данных (better-sqlite3)
DB_PATH=./data/bot.sqlite

# Каталог, куда сохраняются скачанные аудиофайлы библиотеки
LIBRARY_DIR=./data/library

# Каталог для временного хранения загруженных TXT-файлов импорта
IMPORTS_DIR=./data/imports

# Громкость по умолчанию для новых серверов, 0-100
DEFAULT_VOLUME=70

# Порог голосования по умолчанию (в процентах от числа людей в голосовом канале)
DEFAULT_VOTE_START_PERCENT=50
DEFAULT_VOTE_STOP_PERCENT=50

# Сколько секунд длится голосование, прежде чем оно истекает
VOTE_TIMEOUT_SECONDS=60

# Таймаут (сек) на обработку одного трека при импорте (поиск + скачивание)
IMPORT_TRACK_TIMEOUT_SECONDS=90

LOG_LEVEL=info
